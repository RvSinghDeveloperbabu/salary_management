# macOS
.DS_Store

# Claude Code local settings. Machine-specific permissions, not shared.
.claude/settings.local.json

# Secrets — never commit. See CLAUDE.md non-negotiable 7.
config/master.key
api/config/master.key
.env
.env.*
!.env.example

# Rails runtime
api/log/*
api/tmp/*
!api/log/.keep
!api/tmp/.keep

# SQLite databases. Generated by db:seed, never source.
api/storage/*
!api/storage/.keep
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.sqlite3-journal

# Frontend build output. Vite writes the bundle into api/public/;
# it is reproducible from source, so it is not tracked.
api/public/assets/
api/public/index.html
api/public/vite.svg
web/dist/

# Dependencies. Installed into named Docker volumes, not the host.
node_modules/
api/vendor/bundle/

# Test coverage
api/coverage/
web/coverage/
