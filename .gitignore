# ---------------------------------------------------------------------------
# Secrets. See CLAUDE.md non-negotiable 7.
#
# These patterns are deliberately broader than the files that exist today.
# A gitignore that only lists known secrets stops working the moment someone
# adds a new one.
# ---------------------------------------------------------------------------

# Rails encrypted credentials. The .enc file IS committed — it is ciphertext
# and useless on its own. The key that decrypts it must never be.
config/master.key
config/credentials/*.key
api/config/master.key
api/config/credentials/*.key
*.key
!*.key.example

# Environment files
.env
.env.*
!.env.example

# Private keys, certificates, keystores
*.pem
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
*.ppk

# Cloud and service credentials
.aws/
.gcloud/
gcloud-service-key.json
service-account*.json
*credentials.json
.netrc
.npmrc
.pypirc

# ---------------------------------------------------------------------------
# Databases. Generated by db:seed, never source.
# ---------------------------------------------------------------------------
api/storage/*
!api/storage/.keep
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.sqlite3-journal
*.db

# ---------------------------------------------------------------------------
# Dependencies. Installed into named Docker volumes, not the host.
# ---------------------------------------------------------------------------
node_modules/
api/vendor/bundle/
.bundle/

# ---------------------------------------------------------------------------
# Build output. The React bundle is reproducible from source.
# ---------------------------------------------------------------------------
api/public/assets/
api/public/index.html
api/public/vite.svg
web/dist/

# ---------------------------------------------------------------------------
# Runtime and transient
# ---------------------------------------------------------------------------
api/log/*
api/tmp/*
!api/log/.keep
!api/tmp/.keep
!api/tmp/pids/.keep
!api/tmp/storage/.keep
*.log
pids/
*.pid

# Test coverage
api/coverage/
web/coverage/

# ---------------------------------------------------------------------------
# Editor and OS
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
.ruby-lsp/

# Claude Code local settings. Machine-specific permissions, not shared.
.claude/settings.local.json

# ---------------------------------------------------------------------------
# Internal planning and design notes. Kept locally, not published.
#
# The first two commits in this repository are still the documentation
# commits, so the requirements-before-code ordering remains verifiable in
# `git log` even though the files are no longer in the working tree.
# ---------------------------------------------------------------------------
docs/
CLAUDE.md
