# Development image for the Rails API.
#
# Deliberately does not COPY the application in. Compose bind-mounts the
# source instead, so an edit on the host is live in the container with no
# rebuild. Gems live in a named volume at BUNDLE_PATH, which keeps them off
# the host and stops Linux-compiled native extensions colliding with anything
# installed under macOS.
FROM ruby:3.4-slim

# build-essential   native gem extensions (websocket-driver, sqlite3, ...)
# libsqlite3-dev    the database itself, per docs/decisions.md 2
# libyaml-dev       psych
# pkg-config        used by several extconf.rb builds
# git               bundler needs it for any git-sourced gem
# curl              container healthcheck
RUN apt-get update -qq \
 && apt-get install --no-install-recommends -y \
      build-essential \
      libsqlite3-dev \
      libyaml-dev \
      pkg-config \
      git \
      curl \
      tzdata \
 && rm -rf /var/lib/apt/lists/*

ENV BUNDLE_PATH=/usr/local/bundle \
    BUNDLE_JOBS=4 \
    BUNDLE_RETRY=3 \
    LANG=C.UTF-8 \
    RAILS_ENV=development

WORKDIR /app

EXPOSE 3000

CMD ["bin/rails", "server", "-b", "0.0.0.0", "-p", "3000"]
